<!--
  ======================================================================================
  FINNEGAN COSMIC STAGE - Main App Component Draft
  Task: frontend_logic_refactor_011
  
  [Refactoring Documentation]
  1. Pure Logic Extraction:
     - Extracted core card and session types into `src/types/card.ts`:
       AuraTrace, CosmicCard, SearchSession, CommandDef, ParamSpec.
     - Extracted Aura Search & 3D Repulsion algorithms into `src/lib/auraSearch.ts`:
       * generateAuraColor (Color Wheel Max Angular Gap Algorithm)
       * transformSearchResults & createAuraTrace
       * calculate3DRepulsionZ & calculateSearchRepulsion (z_new = z_old + 35 + N * 4)
       * commitUnallocatedSearchResults
     - Extracted Cosmic Stage Decay & Replenishment logic into `src/lib/stageDecay.ts`:
       * Constants: BASE_CAPACITY, MACRO_TTL_MS, BASE_STAGE_DECAY_MS
       * calculateDecayDuration (Dynamic Half-Life & Queue Pressure)
       * stageCandidate (3D Scatter & Spatial Placement)
       * getUnstagedMemoryCards & fetchNewCardIntoMemory
       * replenishStageCandidates (80/20 Resting/Vault Balance & Search Priority)
  2. Main App Component Cleanup:
     - Reduced App.svelte script footprint by delegating pure algorithms to modular libraries.
     - Replaced inlined algorithms with typed pure function calls.
     - Fully preserved all DOM templates, reactive statements, event handlers, and styling.
  ======================================================================================
-->
<script lang="ts">
  import { onMount } from 'svelte';
  import UICard from './UICard.svelte';
  import { spring } from 'svelte/motion';
  import { 
    CaptureThought, 
    GetTempCards, 
    LoadLocalCards, 
    SearchLocalCards, 
    GetRegisteredCommands, 
    ExecuteModuleCommand 
  } from '../wailsjs/go/main/App.js';
  import { EventsOn } from '../wailsjs/runtime/runtime.js';

  import type { CosmicCard, SearchSession, CommandDef } from './types/card';
  import { 
    generateAuraColor, 
    transformSearchResults, 
    calculateSearchRepulsion, 
    commitUnallocatedSearchResults 
  } from './lib/auraSearch';
  import { 
    BASE_CAPACITY, 
    MACRO_TTL_MS, 
    BASE_STAGE_DECAY_MS, 
    stageCandidate, 
    replenishStageCandidates 
  } from './lib/stageDecay';

  let memoryPool: CosmicCard[] = [];             // In-memory transient cards (Bugu / Radar)
  let localVaultPool: CosmicCard[] = [];         // Local Markdown cards (Scattering + Waving)
  let cards: CosmicCard[] = [];                  // Currently rendered active cards on stage
  let latestManualCardId: string | null = null;  // Single exclusive VIP thought

  let focusedCardId: string | null = null;
  let hoveredCardId: string | null = null;
  let omniText = "";
  let capturePending = false;
  let time = 0;
  let omnibarInputEl: HTMLTextAreaElement | null = null;

  // --- Command Assembly State ---
  let availableCommands: CommandDef[] = [];
  let commandSelectMode: boolean = false;
  let highlightedCmdIndex: number = 0;

  let commandParamMode: boolean = false;
  let selectedCommand: CommandDef | null = null;
  let lockedCard: CosmicCard | null = null;
  let paramCardCandidates: CosmicCard[] = [];
  let highlightedCardIndex: number = 0;
  let paramSearchDebounceTimer: any = null;

  // Status Feedback Toast
  let toastMessage: string | null = null;
  let toastTimer: any = null;

  function showToast(msg: string, durationMs: number = 3200) {
    toastMessage = msg;
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toastMessage = null;
    }, durationMs);
  }

  // --- Aura Search Session State ---
  let searchSession: SearchSession = {
    isActive: false,
    searchId: '',
    stashedCards: [],
    rankedResults: [],
    color: ''
  };
  let searchDebounceTimer: any = null;

  // --- Gravitational Tide (Y-Axis Expansion) ---
  let scrollExpansion = spring(0, { stiffness: 0.05, damping: 0.3 }); // 0 = single screen, 1 = expanded
  let tideTimer: any = null;

  $: targetCapacity = Math.round(BASE_CAPACITY * (1 + $scrollExpansion * 0.6));

  function resetTideTimer() {
    if (tideTimer) clearTimeout(tideTimer);
    tideTimer = setTimeout(() => {
      // 45s inactivity -> Smooth gravitational collapse
      scrollExpansion.set(0);
      setTimeout(() => {
        // Gently dismiss cards that ended up far below in expanded space
        cards.forEach(c => {
          if (c.y > 400 && !c.isVIP && !c.isFadingOut) {
            c.isFadingOut = true;
            setTimeout(() => {
              cards = cards.filter(item => item.id !== c.id);
            }, 2500);
          }
        });
      }, 1000);
    }, 45000);
  }

  function handleWheel(e: WheelEvent) {
    if (focusedCardId !== null) return; // Allow reading inside focused card

    if (e.deltaY > 0) {
      // Scroll down -> extend Y space
      const current = $scrollExpansion;
      scrollExpansion.set(Math.min(1.0, current + e.deltaY * 0.0012));
      resetTideTimer();
      replenishStage(); // Promptly populate newly revealed space with 80/20 rule or search results
    } else if (e.deltaY < 0) {
      // Scroll up -> retract
      const current = $scrollExpansion;
      scrollExpansion.set(Math.max(0, current + e.deltaY * 0.0012));
      resetTideTimer();
    }
  }

  function replenishStage() {
    const res = replenishStageCandidates({
      targetCapacity,
      cards,
      memoryPool,
      localVaultPool,
      searchSession,
      scrollExpansion: $scrollExpansion
    });

    if (res.updatedMemoryPool) {
      memoryPool = res.updatedMemoryPool;
    }
    if (res.remainingRankedResults !== undefined) {
      searchSession.rankedResults = res.remainingRankedResults;
    }
    if (res.newCardsToStage.length > 0) {
      cards = [...cards, ...res.newCardsToStage];
    }
  }

  // --- Cosmic 3D Repulsion & Aura Search Execution ---
  async function applySearchRepulsion(rawResults: any[]) {
    if (!rawResults || rawResults.length === 0) return;

    const now = Date.now();
    // Stash current stage upon initiating search session (Requirement C)
    if (!searchSession.isActive) {
      searchSession.stashedCards = cards.map(c => ({ ...c }));
      searchSession.isActive = true;
    }

    const searchColor = generateAuraColor(cards, memoryPool);
    const searchId = 'search_' + now;
    searchSession.searchId = searchId;
    searchSession.color = searchColor;

    // Map raw results to CosmicCard format with updated aura traces
    const searchCards = transformSearchResults(
      rawResults,
      [cards, memoryPool, localVaultPool],
      searchId,
      searchColor,
      now,
      MACRO_TTL_MS,
      BASE_STAGE_DECAY_MS
    );

    const repulsion = calculateSearchRepulsion(cards, searchCards, targetCapacity);
    searchSession.rankedResults = repulsion.rankedResults;
    cards = repulsion.stagedCards;
  }

  // Esc (一闪念): Revert stage to clean pre-search state with zero memory footprint
  function revertSearchView() {
    if (!searchSession.isActive) return;
    cards = searchSession.stashedCards.map(c => ({ ...c }));
    searchSession.isActive = false;
    searchSession.stashedCards = [];
    searchSession.rankedResults = [];
    searchSession.searchId = '';
    omniText = "";
    if (omnibarInputEl) {
      omnibarInputEl.style.height = 'auto';
    }
  }

  // Enter (固化): Commits current view and retains unallocated search results into memoryPool
  function commitSearchView() {
    if (!searchSession.isActive) return;
    memoryPool = commitUnallocatedSearchResults(
      searchSession.rankedResults,
      cards,
      memoryPool,
      MACRO_TTL_MS
    );

    searchSession.isActive = false;
    searchSession.stashedCards = [];
    searchSession.rankedResults = [];
    searchSession.searchId = '';
    omniText = "";
    if (omnibarInputEl) {
      omnibarInputEl.style.height = 'auto';
    }
  }

  function handleFreeSearch(text: string) {
    if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
    const query = text.trim();
    if (query.length < 2) return;

    searchDebounceTimer = setTimeout(async () => {
      try {
        const results = await SearchLocalCards(query);
        if (results && results.length > 0) {
          applySearchRepulsion(results);
        }
      } catch (err) {
        console.error("SearchLocalCards error:", err);
      }
    }, 250);
  }

  // --- Command System Logic ---
  $: cmdQuery = omniText.startsWith('/') ? omniText.slice(1).trim().toLowerCase() : '';

  $: matchedCommands = commandSelectMode 
    ? availableCommands.filter(cmd => {
        const trig = (cmd.trigger || '').replace(/^\//, '').toLowerCase();
        const name = (cmd.name || '').toLowerCase();
        const desc = (cmd.description || '').toLowerCase();
        return !cmdQuery || trig.includes(cmdQuery) || name.includes(cmdQuery) || desc.includes(cmdQuery);
      })
    : [];

  function selectCommand(cmd: CommandDef) {
    selectedCommand = cmd;
    commandSelectMode = false;
    commandParamMode = true;
    omniText = "";
    lockedCard = null;
    highlightedCardIndex = 0;
    searchParamCards("");
  }

  function lockCard(candidate: CosmicCard) {
    lockedCard = candidate;
    paramCardCandidates = [];
    omniText = "";
    if (omnibarInputEl) {
      omnibarInputEl.style.height = 'auto';
    }
  }

  function unlockCard() {
    lockedCard = null;
    omniText = "";
    searchParamCards("");
  }

  function exitCommandMode() {
    commandParamMode = false;
    commandSelectMode = false;
    selectedCommand = null;
    lockedCard = null;
    paramCardCandidates = [];
    omniText = "";
    if (omnibarInputEl) {
      omnibarInputEl.style.height = 'auto';
    }
  }

  async function executeCurrentCommand() {
    if (!selectedCommand || !lockedCard) return;
    const cmd = selectedCommand;
    const card = lockedCard;
    
    showToast(`${cmd.name || cmd.trigger} 已启动...`);
    
    try {
      await ExecuteModuleCommand(cmd.id, {
        cardId: card.id,
        card: card,
        content: card.content || card.title,
        id: card.id,
        text: card.content || card.title
      });
    } catch (err: any) {
      console.error("ExecuteModuleCommand error:", err);
      showToast(`执行失败: ${err?.message || err}`);
    } finally {
      commandParamMode = false;
      selectedCommand = null;
      lockedCard = null;
      omniText = "";
      if (omnibarInputEl) {
        omnibarInputEl.style.height = 'auto';
      }
    }
  }

  function searchParamCards(text: string) {
    if (paramSearchDebounceTimer) clearTimeout(paramSearchDebounceTimer);
    const q = text.trim();
    paramSearchDebounceTimer = setTimeout(async () => {
      try {
        if (!q) {
          // If empty query, show top cards from stage & vault as immediate options (deduplicated)
          const rawPool = [...cards.filter(c => !c.isFadingOut), ...localVaultPool];
          const seenIds = new Set<string>();
          const seenContent = new Set<string>();
          const uniqueCandidates: CosmicCard[] = [];

          for (const c of rawPool) {
            const normContent = (c.content || '').trim();
            if (c.id && seenIds.has(c.id)) continue;
            if (normContent && seenContent.has(normContent)) continue;
            if (c.id) seenIds.add(c.id);
            if (normContent) seenContent.add(normContent);
            uniqueCandidates.push(c);
            if (uniqueCandidates.length >= 6) break;
          }

          paramCardCandidates = uniqueCandidates;
          highlightedCardIndex = 0;
          return;
        }

        const results = await SearchLocalCards(q);
        if (results && results.length > 0) {
          const seenIds = new Set<string>();
          const seenContent = new Set<string>();
          const uniqueResults: CosmicCard[] = [];

          for (const r of results) {
            const normContent = (r.content || '').trim();
            if (r.id && seenIds.has(r.id)) continue;
            if (normContent && seenContent.has(normContent)) continue;
            if (r.id) seenIds.add(r.id);
            if (normContent) seenContent.add(normContent);

            uniqueResults.push({
              id: r.id,
              type: r.type || 'thought',
              title: r.title || 'Card',
              content: r.content || '',
              originalText: r.originalText || '',
              translatedText: r.translatedText || '',
              sourceUrl: r.sourceUrl || '',
              x: 0, y: 0, rotation: 0, z: 50,
              spawnTime: 0, decayDuration: 0, isFresh: false, isVIP: false,
              origin: r.type === 'babel' ? 'bugu' : 'local'
            });
            if (uniqueResults.length >= 8) break;
          }
          paramCardCandidates = uniqueResults;
        } else {
          paramCardCandidates = [];
        }
        highlightedCardIndex = 0;
      } catch (err) {
        console.error("searchParamCards error:", err);
        paramCardCandidates = [];
      }
    }, 250);
  }

  // --- Keyboard & Input Event Handling ---
  async function captureCurrentThought() {
    const text = omniText.trim();
    if (!text || capturePending) return;
    capturePending = true;
    try {
      await CaptureThought(text);
      omniText = "";
      if (searchSession.isActive) {
        commitSearchView();
      }
      if (omnibarInputEl) {
        omnibarInputEl.style.height = 'auto';
      }
    } catch (err: any) {
      console.error(err);
      const oldText = text;
      omniText = "Error: " + err;
      setTimeout(() => { if (omniText.startsWith("Error:")) omniText = oldText; }, 2000);
    } finally {
      capturePending = false;
    }
  }

  async function handleOmnibarKeydown(e: KeyboardEvent) {
    // Mode 1: Command Selection Dropdown Active
    if (commandSelectMode) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (matchedCommands.length > 0) {
          highlightedCmdIndex = (highlightedCmdIndex + 1) % matchedCommands.length;
        }
        return;
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (matchedCommands.length > 0) {
          highlightedCmdIndex = (highlightedCmdIndex - 1 + matchedCommands.length) % matchedCommands.length;
        }
        return;
      }
      if (e.key === ' ' || e.key === 'Spacebar') {
        const clean = cmdQuery;
        const matched = matchedCommands.find(cmd => (cmd.trigger || '').replace(/^\//, '').toLowerCase() === clean);
        if (matched) {
          e.preventDefault();
          selectCommand(matched);
          return;
        } else if (matchedCommands.length > 0 && highlightedCmdIndex >= 0 && highlightedCmdIndex < matchedCommands.length) {
          const highlighted = matchedCommands[highlightedCmdIndex];
          if ((highlighted.trigger || '').replace(/^\//, '').toLowerCase() === clean) {
            e.preventDefault();
            selectCommand(highlighted);
            return;
          }
        }
      }
      if (e.key === 'Enter' || e.key === 'Tab') {
        e.preventDefault();
        if (matchedCommands.length > 0 && highlightedCmdIndex >= 0 && highlightedCmdIndex < matchedCommands.length) {
          selectCommand(matchedCommands[highlightedCmdIndex]);
        }
        return;
      }
      if (e.key === 'Escape') {
        e.preventDefault();
        commandSelectMode = false;
        omniText = "";
        return;
      }
    }

    // Space trigger: Typing a valid command name (e.g. "/bugu" or "bugu") + Space enters param mode immediately
    if ((e.key === ' ' || e.key === 'Spacebar') && !commandParamMode) {
      const clean = omniText.trim().replace(/^\//, '').toLowerCase();
      const exactCmd = availableCommands.find(cmd => (cmd.trigger || '').replace(/^\//, '').toLowerCase() === clean);
      if (exactCmd) {
        e.preventDefault();
        selectCommand(exactCmd);
        return;
      }
    }

    // Mode 2: Command Parameter Mode Active (Two-Stage Enter)
    if (commandParamMode) {
      if (lockedCard) {
        // Card is locked: Enter 2 submits command; Esc/Backspace unlocks
        if (e.key === 'Enter') {
          e.preventDefault();
          await executeCurrentCommand();
          return;
        }
        if (e.key === 'Escape' || e.key === 'Backspace') {
          e.preventDefault();
          unlockCard();
          return;
        }
      } else {
        // Param candidate search dropdown active
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (paramCardCandidates.length > 0) {
            highlightedCardIndex = (highlightedCardIndex + 1) % paramCardCandidates.length;
          }
          return;
        }
        if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (paramCardCandidates.length > 0) {
            highlightedCardIndex = (highlightedCardIndex - 1 + paramCardCandidates.length) % paramCardCandidates.length;
          }
          return;
        }
        if (e.key === 'Enter') {
          e.preventDefault();
          if (paramCardCandidates.length > 0 && highlightedCardIndex >= 0 && highlightedCardIndex < paramCardCandidates.length) {
            // Enter 1: Lock card candidate
            lockCard(paramCardCandidates[highlightedCardIndex]);
          }
          return;
        }
        if (e.key === 'Escape') {
          e.preventDefault();
          exitCommandMode();
          return;
        }
        if (e.key === 'Backspace' && omniText === '') {
          e.preventDefault();
          exitCommandMode();
          return;
        }
      }
    }

    // Mode 3: Normal Mode Thought Capture vs Search Solidify
    if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
      // Capturing a thought ONLY triggers on (e.metaKey || e.ctrlKey) && e.key === 'Enter'
      e.preventDefault();
      await captureCurrentThought();
      return;
    }

    if (e.key === 'Enter') {
      if (searchSession.isActive) {
        // Enter (固化) commits current search view
        e.preventDefault();
        commitSearchView();
        return;
      }
      // Plain text multiline editing: allow standard newline insertion
    }

    if (e.key === 'Escape') {
      if (searchSession.isActive) {
        // Esc (一闪念) reverts stage
        e.preventDefault();
        revertSearchView();
        return;
      }
    }
  }

  function handleInput(e: Event) {
    const target = e.target as HTMLTextAreaElement;
    target.style.height = 'auto';
    target.style.height = target.scrollHeight + 'px';

    // Auto-detect command trigger followed by a space (e.g. "/bugu " or "bugu ")
    if (!commandParamMode) {
      const spaceIdx = omniText.indexOf(' ');
      if (spaceIdx > 0) {
        const cmdPart = omniText.slice(0, spaceIdx).trim().replace(/^\//, '').toLowerCase();
        const found = availableCommands.find(c => (c.trigger || '').replace(/^\//, '').toLowerCase() === cmdPart);
        if (found) {
          const restText = omniText.slice(spaceIdx + 1);
          selectCommand(found);
          if (restText) {
            omniText = restText;
            searchParamCards(restText);
          }
          return;
        }
      }
    }

    if (commandParamMode) {
      if (!lockedCard) {
        searchParamCards(omniText);
      }
    } else if (omniText.startsWith('/')) {
      commandSelectMode = true;
      highlightedCmdIndex = 0;
    } else {
      commandSelectMode = false;
      if (omniText.trim().length >= 2) {
        handleFreeSearch(omniText);
      }
    }
  }

  function handleWindowKeydown(e: KeyboardEvent) {
    if (e.key === 'Escape') {
      if (focusedCardId !== null) {
        focusedCardId = null;
        return;
      }
      if (commandParamMode) {
        if (lockedCard) {
          unlockCard();
        } else {
          exitCommandMode();
        }
        return;
      }
      if (commandSelectMode) {
        commandSelectMode = false;
        omniText = "";
        return;
      }
      if (searchSession.isActive) {
        revertSearchView();
        return;
      }
    }
  }

  let isOmnibarFocused = false;
  $: showTopBanner = (omniText.trim().length > 0) || commandParamMode || commandSelectMode || searchSession.isActive;

  $: omnibarPlaceholder = commandParamMode
    ? (selectedCommand?.params?.[0]?.description || "吾道不孤")
    : "Capture a thought...";

  // --- Lifecycle Initializations ---
  onMount(() => {
    // 1. Load Registered Module Commands
    GetRegisteredCommands().then((cmds: any) => {
      if (cmds && Array.isArray(cmds)) {
        availableCommands = cmds;
      }
    }).catch(err => {
      console.warn("Could not load registered commands:", err);
    });

    // 2. Initial Load of Local & In-Memory Cards
    const loadCards = async () => {
      try {
        const localCards = await LoadLocalCards();
        const tempCards = await GetTempCards();
        
        if (tempCards && tempCards.length > 0) {
          memoryPool = tempCards.map((c: any) => ({
            id: c.id || c.ID,
            type: 'babel',
            title: c.title || c.Title || 'Babel Echo',
            content: c.content || c.Content || c.translatedText || c.TranslatedText || c.translated_text || '',
            originalText: c.originalText || c.OriginalText || c.original_text || '',
            translatedText: c.translatedText || c.TranslatedText || c.translated_text || '',
            sourceUrl: c.sourceUrl || c.SourceURL || c.source_url || '',
            x: 0, y: 0, rotation: 0, z: 50,
            spawnTime: 0,
            decayDuration: 0,
            isFresh: false,
            isVIP: false,
            origin: 'bugu',
            macroExpiresAt: Date.now() + MACRO_TTL_MS
          }));
        }

        if (localCards && localCards.length > 0) {
          localVaultPool = localCards.map((c: any) => ({
            id: c.id || c.ID,
            type: c.type || c.Type || 'thought',
            title: c.title || c.Title || 'Thought',
            content: c.content || c.Content || '',
            originalText: c.originalText || c.OriginalText || '',
            translatedText: c.translatedText || c.TranslatedText || '',
            sourceUrl: c.sourceUrl || c.SourceURL || '',
            x: 0, y: 0, rotation: 0, z: 50,
            spawnTime: 0,
            decayDuration: 0,
            isFresh: false,
            isVIP: false,
            origin: 'local'
          }));
        }

        replenishStage();
      } catch (err) {
        console.error("loadCards error:", err);
      }
    };
    loadCards();

    // 3. Real-time Event: User Thought Captured
    EventsOn("thought:captured", (data: any) => {
      const cardId = data.DocID || ('thought_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7));
      
      if (latestManualCardId) {
        const prevVIP = cards.find(c => c.id === latestManualCardId);
        if (prevVIP) {
          prevVIP.isVIP = false;
          prevVIP.decayDuration = BASE_STAGE_DECAY_MS;
        }
      }
      latestManualCardId = cardId;

      const newCard: CosmicCard = {
        id: cardId,
        type: 'thought',
        title: 'Thought',
        content: data.Text,
        x: (Math.random() - 0.5) * 600,
        y: (Math.random() - 0.5) * 300,
        rotation: (Math.random() - 0.5) * 20,
        z: Math.random() * 40 + 10,
        spawnTime: Date.now(),
        decayDuration: 12 * 3600 * 1000,
        isFresh: true,
        isVIP: true,
        origin: 'manual'
      };

      localVaultPool = [newCard, ...localVaultPool.filter(c => c.id !== newCard.id)];

      if (cards.filter(c => !c.isFadingOut).length >= targetCapacity) {
        const evictable = cards
          .filter(c => !c.isVIP && !c.isFadingOut)
          .sort((a, b) => (a.spawnTime + a.decayDuration) - (b.spawnTime + b.decayDuration));
        if (evictable.length > 0) {
          evictable[0].isFadingOut = true;
          setTimeout(() => {
            cards = cards.filter(c => c.id !== evictable[0].id);
          }, 2500);
        }
      }

      cards = [...cards.filter(c => c.id !== newCard.id), newCard];
    });

    // 4. Real-time Event: Bugu Babel Card Spawned
    EventsOn("bugu:card_spawned", (c: any) => {
      const cardId = c.id || c.ID || ('babel_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7));
      const transText = c.translatedText || c.TranslatedText || c.translated_text || '';
      const origText = c.originalText || c.OriginalText || c.original_text || '';
      const srcUrl = c.sourceUrl || c.SourceURL || c.source_url || '';

      const newCard: CosmicCard = {
        id: cardId,
        type: 'babel',
        title: c.title || c.Title || 'Babel Echo',
        content: c.content || c.Content || transText || origText || '',
        originalText: origText,
        translatedText: transText,
        sourceUrl: srcUrl,
        x: (Math.random() - 0.5) * 600,
        y: (Math.random() - 0.5) * 300,
        rotation: (Math.random() - 0.5) * 20,
        z: Math.random() * 40 + 10,
        spawnTime: Date.now(),
        decayDuration: BASE_STAGE_DECAY_MS,
        isFresh: true,
        isVIP: false,
        origin: 'bugu',
        macroExpiresAt: Date.now() + MACRO_TTL_MS
      };

      memoryPool = [newCard, ...memoryPool.filter(m => m.id !== cardId)];

      if (cards.filter(c => !c.isFadingOut).length < targetCapacity) {
        const staged = stageCandidate(newCard, true, $scrollExpansion, cards, memoryPool);
        cards = [...cards.filter(c => c.id !== staged.id), staged];
      }
    });

    // 5. Metabolic Lifecycle Heartbeat (Runs every 2s)
    const metabolicInterval = setInterval(() => {
      const now = Date.now();

      memoryPool = memoryPool.filter(c => !c.macroExpiresAt || c.macroExpiresAt > now);

      cards.forEach(c => {
        if (c.isFresh && now - c.spawnTime > 8 * 60 * 1000) {
          c.isFresh = false;
        }
      });

      cards.forEach(c => {
        if (!c.isVIP && !c.isFadingOut && (now - c.spawnTime > c.decayDuration)) {
          c.isFadingOut = true;
          setTimeout(() => {
            cards = cards.filter(card => card.id !== c.id);
          }, 2500);
        }
      });

      replenishStage();
    }, 2000);

    // 6. 3D Render Animation Loop
    let frame: number;
    const loop = () => {
      time = performance.now() * 0.001;
      frame = requestAnimationFrame(loop);
    };
    loop();

    return () => {
      cancelAnimationFrame(frame);
      clearInterval(metabolicInterval);
      if (tideTimer) clearTimeout(tideTimer);
      if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
      if (paramSearchDebounceTimer) clearTimeout(paramSearchDebounceTimer);
      if (toastTimer) clearTimeout(toastTimer);
    };
  });

  // Global Tilt Spring
  let globalTilt = spring({ rx: 0, ry: 0 }, { stiffness: 0.04, damping: 0.25 });

  function handleMouseMove(e: MouseEvent) {
    resetTideTimer();
    const mX = (e.clientX / window.innerWidth) * 2 - 1;
    const mY = (e.clientY / window.innerHeight) * 2 - 1;
    
    if (focusedCardId === null) {
      globalTilt.set({ rx: mY * 15, ry: -mX * 15 });
    } else {
      globalTilt.set({ rx: 0, ry: 0 });
    }
  }

  function toggleFocus(id: string) {
    resetTideTimer();
    if (focusedCardId === id) {
      focusedCardId = null;
    } else {
      focusedCardId = id;
      globalTilt.set({ rx: 0, ry: 0 }, { hard: true });
    }
  }

  function handleBgClick(e: MouseEvent) {
    resetTideTimer();
    if (e.target === e.currentTarget) {
      focusedCardId = null;
      if (commandSelectMode) commandSelectMode = false;
    }
  }
</script>

<svelte:window 
  on:keydown={handleWindowKeydown} 
  on:mousemove={handleMouseMove} 
  on:wheel={handleWheel}
/>

<!-- svelte-ignore a11y-click-events-have-key-events -->
<!-- svelte-ignore a11y-no-static-element-interactions -->
<div class="container" on:click={handleBgClick}>
  <!-- Omnibar Container with Universal Two-Stage Assembly & Command Badges -->
  <div class="omnibar-container" class:faded={focusedCardId !== null}>
    <!-- Floating Toast Feedback Banner -->
    {#if toastMessage}
      <div class="toast-feedback">
        {toastMessage}
      </div>
    {/if}

    <!-- Top Action Banner / 条幅提示 -->
    {#if showTopBanner}
      <div class="omnibar-top-banner">
        {#if commandParamMode}
          {#if lockedCard}
            <span class="banner-badge ready-badge">🚀 准备就绪</span>
            <span class="banner-key">↵</span>
            <span class="banner-action">执行命令</span>
            <span class="banner-sep">·</span>
            <span class="banner-key">Esc</span>
            <span class="banner-action">重新选择</span>
          {:else}
            <span class="banner-badge param-badge">📄 观点参数</span>
            <span class="banner-key">↑ ↓</span>
            <span class="banner-action">移动</span>
            <span class="banner-sep">·</span>
            <span class="banner-key">↵</span>
            <span class="banner-action">锁定卡片</span>
            <span class="banner-sep">·</span>
            <span class="banner-key">Esc</span>
            <span class="banner-action">退出</span>
          {/if}
        {:else if commandSelectMode}
          <span class="banner-badge cmd-badge">🔭 模块命令</span>
          <span class="banner-key">↑ ↓</span>
          <span class="banner-action">选择</span>
          <span class="banner-sep">·</span>
          <span class="banner-key">↵</span>
          <span class="banner-action">确认</span>
          <span class="banner-sep">·</span>
          <span class="banner-key">Esc</span>
          <span class="banner-action">取消</span>
        {:else if searchSession.isActive}
          <span class="banner-badge search-badge" style="--glow-color: {searchSession.color || 'hsl(180, 95%, 62%)'}">
            <span class="banner-dot"></span> 探针共鸣中
          </span>
          <span class="banner-key">↵</span>
          <span class="banner-action">固化回声</span>
          <span class="banner-sep">·</span>
          <span class="banner-key">Esc</span>
          <span class="banner-action">一闪念还原</span>
        {:else}
          <span class="banner-key">⌘ ↵</span>
          <span class="banner-action">发送思绪</span>
          <span class="banner-sep">·</span>
          <span class="banner-key">↵</span>
          <span class="banner-action">换行</span>
          <span class="banner-sep">·</span>
          <span class="banner-key">/</span>
          <span class="banner-action">命令</span>
        {/if}
      </div>
    {/if}

    <div class="omnibar-box" class:command-mode={commandParamMode}>
      <!-- Command Chip Badge: [🔭 /cmd] -->
      {#if commandParamMode && selectedCommand}
        <div class="omnibar-chip command-chip">
          <span class="chip-icon">🔭</span>
          <span class="chip-label">/{selectedCommand.trigger.replace(/^\//, '')}</span>
          <button class="chip-close" on:click={exitCommandMode} title="退出命令模式">✕</button>
        </div>
      {/if}

      <!-- Locked Card Parameter Chip Badge: [📄 <Card Title> ✕] -->
      {#if commandParamMode && lockedCard}
        <div class="omnibar-chip card-chip">
          <span class="chip-icon">📄</span>
          <span class="chip-label">{lockedCard.title || lockedCard.content.slice(0, 16)}</span>
          <button class="chip-close" on:click={unlockCard} title="按 Esc 重新选择">✕</button>
        </div>
      {:else}
        <!-- Omnibar Input -->
        <textarea 
          bind:this={omnibarInputEl}
          class="omnibar-input" 
          placeholder={omnibarPlaceholder} 
          bind:value={omniText}
          on:keydown={handleOmnibarKeydown}
          on:input={handleInput}
          on:focus={() => isOmnibarFocused = true}
          on:blur={() => isOmnibarFocused = false}
          disabled={capturePending}
          rows="1"
        ></textarea>
      {/if}
    </div>

    <!-- Dropdown 1: Command Selection Suggestions -->
    {#if commandSelectMode && matchedCommands.length > 0}
      <div class="dropdown-menu command-dropdown">
        {#each matchedCommands as cmd, index}
          <!-- svelte-ignore a11y-click-events-have-key-events -->
          <!-- svelte-ignore a11y-no-static-element-interactions -->
          <div 
            class="dropdown-item" 
            class:active={index === highlightedCmdIndex}
            on:mouseenter={() => highlightedCmdIndex = index}
            on:mousedown|preventDefault={() => selectCommand(cmd)}
          >
            <div class="cmd-item-header">
              <span class="cmd-icon">🔭</span>
              <span class="cmd-trigger">/{cmd.trigger.replace(/^\//, '')}</span>
            </div>
          </div>
        {/each}
      </div>
    {/if}

    <!-- Dropdown 2: Parameter Card Candidates -->
    {#if commandParamMode && !lockedCard && paramCardCandidates.length > 0}
      <div class="dropdown-menu card-dropdown">
        {#each paramCardCandidates as candidate, index}
          <!-- svelte-ignore a11y-click-events-have-key-events -->
          <!-- svelte-ignore a11y-no-static-element-interactions -->
          <div 
            class="dropdown-item card-item" 
            class:active={index === highlightedCardIndex}
            on:mouseenter={() => highlightedCardIndex = index}
            on:mousedown|preventDefault={() => lockCard(candidate)}
          >
            <div class="card-item-title">
              <span class="candidate-icon">📄</span>
              {candidate.title || 'Untitled Card'}
            </div>
            <div class="card-item-snippet">
              {candidate.content || candidate.translatedText || candidate.originalText || ''}
            </div>
          </div>
        {/each}
      </div>
    {/if}
  </div>

  <!-- Cards container -->
  <div class="cards-wrapper" class:elevated={(hoveredCardId !== null && !isOmnibarFocused) || focusedCardId !== null} on:click={handleBgClick}>
    <!-- svelte-ignore a11y-click-events-have-key-events -->
    <!-- svelte-ignore a11y-no-static-element-interactions -->
    <div 
      class="scene" 
      style="
        transform: rotateX({$globalTilt.rx}deg) rotateY({$globalTilt.ry}deg) translateY({-$scrollExpansion * 300}px); 
        transform-style: preserve-3d;
      "
    >
      {#each cards as card (card.id)}
        <UICard 
          {card}
          {time}
          globalTilt={$globalTilt}
          isFocused={focusedCardId === card.id}
          isHovered={hoveredCardId === card.id}
          onToggleFocus={() => toggleFocus(card.id)}
          onHover={() => { hoveredCardId = card.id; resetTideTimer(); }}
          onLeave={() => hoveredCardId = null}
        />
      {/each}
    </div>
  </div>
</div>

<style>
  /* Reset background for translucent macOS window */
  :global(body), :global(html), :global(#app) {
    background: transparent !important;
    background-color: transparent !important;
    margin: 0;
    padding: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }

  .container {
    width: 100vw;
    height: 100vh;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
  }

  .omnibar-container {
    position: absolute;
    z-index: 50; /* Above normal background cards */
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: opacity 0.5s ease, filter 0.5s ease;
    width: 580px;
    max-width: 90vw;
  }

  .omnibar-container.faded {
    opacity: 0;
    filter: blur(10px);
    pointer-events: none;
  }

  .omnibar-box {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: 30px;
    border: 2px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(0, 0, 0, 0.05);
    transition: background 0.3s ease, border 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease;
    box-sizing: border-box;
    min-height: 60px;
  }

  .omnibar-box:focus-within {
    background: rgba(255, 255, 255, 0.96);
    border: 2px solid rgba(255, 255, 255, 1);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2), 0 0 0 1px rgba(0, 0, 0, 0.05);
    transform: scale(1.015);
  }

  .omnibar-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 1.15rem;
    color: #333;
    outline: none;
    text-align: left;
    resize: none;
    min-height: 28px;
    max-height: 200px;
    overflow-y: auto;
    line-height: 1.5;
    box-sizing: border-box;
    font-family: inherit;
    padding: 4px 6px;
  }

  .omnibar-input::placeholder {
    color: rgba(51, 51, 51, 0.55);
  }

  /* Hide scrollbar for omnibar input */
  .omnibar-input::-webkit-scrollbar {
    display: none;
  }
  .omnibar-input {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Omnibar Chips */
  .omnibar-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 16px;
    font-size: 0.9rem;
    font-weight: 550;
    user-select: none;
    white-space: nowrap;
    animation: chip-appear 0.2s cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  @keyframes chip-appear {
    from { transform: scale(0.85); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .command-chip {
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.35);
    color: #1d4ed8;
  }

  .card-chip {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: #065f46;
    max-width: 250px;
  }

  .chip-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chip-close {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 0.8rem;
    color: inherit;
    opacity: 0.6;
    padding: 0 2px;
    margin-left: 2px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    transition: opacity 0.15s;
  }

  .chip-close:hover {
    opacity: 1;
  }

  /* Dropdown Menus */
  .dropdown-menu {
    width: 100%;
    margin-top: 8px;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 20px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.16);
    overflow: hidden;
    max-height: 280px;
    overflow-y: auto;
    z-index: 60;
    display: flex;
    flex-direction: column;
    animation: dropdown-slide 0.15s ease-out;
    box-sizing: border-box;
  }

  @keyframes dropdown-slide {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .dropdown-item {
    padding: 10px 16px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    cursor: pointer;
    transition: background 0.15s ease;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
  }

  .dropdown-item:last-child {
    border-bottom: none;
  }

  .dropdown-item.active,
  .dropdown-item:hover {
    background: rgba(59, 130, 246, 0.1);
  }

  .cmd-item-header {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cmd-trigger {
    font-weight: 700;
    color: #2563eb;
    font-size: 0.95rem;
  }

  .card-item-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: #111827;
    font-size: 0.92rem;
  }

  .card-item-snippet {
    font-size: 0.8rem;
    color: rgba(75, 85, 99, 0.75);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.35;
  }

  .toast-feedback {
    margin-bottom: 10px;
    padding: 8px 18px;
    background: rgba(17, 24, 39, 0.88);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 500;
    border-radius: 20px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    pointer-events: none;
    animation: toast-in 0.25s cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  @keyframes toast-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Top Action Banner / 条幅提示 */
  .omnibar-top-banner {
    align-self: flex-start;
    margin-left: 22px;
    margin-bottom: 6px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
