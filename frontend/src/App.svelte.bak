  .banner-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 1px 6px;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.68rem;
    letter-spacing: 0.02em;
  }

  .banner-badge.cmd-badge {
    background: rgba(59, 130, 246, 0.12);
    color: #2563eb;
  }

  .banner-badge.param-badge {
    background: rgba(16, 185, 129, 0.12);
    color: #059669;
  }

  .banner-badge.ready-badge {
    background: rgba(245, 158, 11, 0.12);
    color: #d97706;
  }

  .banner-badge.search-badge {
    background: rgba(147, 51, 234, 0.1);
    color: #7e22ce;
  }

  .banner-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--glow-color, #7e22ce);
    box-shadow: 0 0 5px var(--glow-color, #7e22ce);
    display: inline-block;
  }

  .banner-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1px 5px;
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 4px;
    font-size: 0.66rem;
    font-weight: 600;
    color: #374151;
    line-height: 1.25;
    font-family: inherit;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .banner-action {
    color: rgba(55, 65, 81, 0.85);
    font-weight: 500;
    font-size: 0.7rem;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.6);
  }

  .banner-sep {
    color: rgba(0, 0, 0, 0.2);
    font-weight: 600;
    font-size: 0.65rem;
    margin: 0 1px;
  }

  /* Cards wrapper & 3D Scene */
  .cards-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    perspective: 1000px;
    pointer-events: none;
    z-index: 5;
  }

  .cards-wrapper.elevated {
    z-index: 100; /* Elevated above omnibar-container (z-index 50) */
  }

  .scene {
    pointer-events: none;
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.1s ease-out;
  }
</style>
